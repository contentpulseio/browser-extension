{
  "manifest_version": 3,
  "name": "ContentPulse: AI SEO Content Writer & Publisher",
  "version": "1.9.1",
  "description": "Fetch SEO-ready content from ContentPulse and auto-fill it into your publishing editor to review and publish in one click.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ContentPulse: AI SEO Content Writer & Publisher",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://contentpulse.io/*",
    "https://*.contentpulse.io/*",
    "https://www.linkedin.com/*",
    "https://www.reddit.com/*",
    "https://old.reddit.com/*",
    "https://medium.com/*",
    "https://*.substack.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/article/*",
        "https://www.linkedin.com/pulse/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "panel.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.reddit.com/r/*"
      ],
      "js": [
        "reddit-helper.js",
        "reddit-panel.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://medium.com/new-story*",
        "https://medium.com/p/*/edit"
      ],
      "js": [
        "medium-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.substack.com/publish/post/*"
      ],
      "js": [
        "substack-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.js",
        "styles.css",
        "assets/*"
      ],
      "matches": [
        "https://www.linkedin.com/*",
        "https://www.reddit.com/*",
        "https://medium.com/*",
        "https://*.substack.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
